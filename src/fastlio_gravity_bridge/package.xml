<?xml version="1.0"?>
<package format="2">
  <name>fastlio_gravity_bridge</name>
  <version>0.1.0</version>

  <description>
    把 FAST-LIO2 在 camera_init 下输出的里程计转换为重力对齐的 world 坐标系输出，
    并给出带协方差的位姿（可选直接发给 MAVROS 外部视觉位姿接口）。
    本次运行的重力对齐旋转由 FAST-LIO2 初始化重力 (/fastlio/gravity_init) 自动确定；
    输出姿态表示机体 base_link，安装补偿默认用固定的安装前倾角 (mounting_pitch_deg，
    默认 20 度，与初始化重力无关，初始化时静止即可、无须水平)，
    位置基点仍是雷达 IMU。
    同时发布 world -> camera_init 与 body -> base_link 两段静态 TF。
  </description>

  <maintainer email="orangepi@example.com">orangepi</maintainer>
  <license>BSD</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>eigen</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>nav_msgs</build_depend>
  <build_depend>roscpp</build_depend>
  <build_depend>tf2</build_depend>
  <build_depend>tf2_ros</build_depend>

  <build_export_depend>eigen</build_export_depend>
  <build_export_depend>geometry_msgs</build_export_depend>
  <build_export_depend>nav_msgs</build_export_depend>
  <build_export_depend>tf2</build_export_depend>
  <build_export_depend>tf2_ros</build_export_depend>

  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>roscpp</exec_depend>
  <exec_depend>tf2</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <test_depend>rostest</test_depend>

  <export>
  </export>
</package>
