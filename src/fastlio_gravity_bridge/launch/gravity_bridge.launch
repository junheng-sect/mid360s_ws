<launch>
  <!--
    FAST-LIO2 重力对齐桥接节点。

    输入：/Odometry (nav_msgs/Odometry, camera_init -> body)
          /fastlio/gravity_init (geometry_msgs/Vector3Stamped, latched, camera_init 下的重力)
    输出：/fastlio/odom_world (nav_msgs/Odometry, drone_odom -> drone_base)
          /fastlio/vision_pose_cov (geometry_msgs/PoseWithCovarianceStamped)
          /tf_static: drone_odom -> camera_init（对齐旋转）与 body -> drone_base（机体安装旋转）

    姿态表示机体（drone_base）而不是雷达 IMU；位置基点仍是雷达 IMU（不做杆臂补偿，
    该偏移由下游 / 飞控参数处理）。

    mounting_source:=fixed（默认）用固定安装旋转做补偿，**与初始化重力无关**，因此
    初始化时机体保持静止即可、不要求水平，输出会如实保留机体的真实倾角（不再把初始
    倾角当作安装角抵消）。三个角度（度）描述雷达 IMU 在机体系（FLU）中的姿态：
      R_base<-lidar = Rz(yaw) · Ry(pitch) · Rx(roll)   （ROS 固定轴 RPY 顺序）
    节点内部取逆作为右乘补偿 q_IB。符号：
      mounting_pitch_deg 正值 = 前倾（机头向下），默认 18.8；
      mounting_roll_deg  正值 = 雷达右侧向下，默认 0.5；
      mounting_yaw_deg   正值 = 雷达前向朝左偏，默认 1.6。
    默认值是本机实测安装角（替代原设计名义值 0/20/0）：roll/pitch 取 10.3 台架双 IMU 与
    LI-Init 初始化的一致结果，yaw 取 10.4 飞行双脉冲结果（与台架 +1.7 同号）。飞行报告
    里写的是 FRD 下 yaw −1.6（雷达前向在机头左侧 1.6 度），换到这里的 FLU 是 +1.6。
    节点代码里的默认值仍是 0/20/0（单元测试依赖），不经本文件启动时需显式传参。
    roll、yaw 都为 0 时即纯俯仰 q_IB = Ry(-mounting_pitch_deg)，与旧行为一致。
    标定结果（如 iKalibr 以飞控 IMU 为参考时 Livox IMU 的 SO3_BiToBr = R_base<-lidar）
    按 ZYX 换算成 roll/pitch/yaw 填入，例如：
      roslaunch fastlio_gravity_bridge gravity_bridge.launch \
          mounting_roll_deg:=0.35 mounting_pitch_deg:=20.12 mounting_yaw_deg:=-0.80

    mounting_source:=gravity 为兼容旧调用保留：由本次初始化重力推导 q_IB = q_a⁻¹，
    前提是 FAST-LIO 初始化时机体保持水平；若初始化时机体本身倾斜，输出会把初始倾角
    一并当作安装角抵消，表现为读数偏小。设为 none 可关闭安装补偿（输出恢复为雷达
    IMU 姿态，child frame 名也会跟着变成 body 更合适）。

    非法的 mounting_source 或非有限的安装角（roll / pitch / yaw）会让节点明确报错并退出启动，
    不再静默兜底成 none。

    send_to_mavros:=true 时，带协方差位姿的输出目的地改为 /mavros/vision_pose/pose_cov，
    同时在 pose_cov_out 上保留一路本地回显（便于板端与 RViz 侧监视）。
    启用 MAVROS 时需在 MAVROS 侧设置 vision_pose/tf/listen=false（用消息订阅代替 TF 监听）。

    ev_mode 选送飞控的方式，启动时定、运行中不切换：
      pose（默认）：只发位姿，走上面的 /mavros/vision_pose/pose_cov（VISION_POSITION_ESTIMATE）；
      odom：位姿 + 速度，走 /mavros/odometry/out（ODOMETRY）。速度取 FAST-LIO 的 /fastlio/velocity
            （与 /Odometry 同时间戳的 camera_init 速度），转成机体系 drone_base 下的速度；同一时间戳的
            位姿和速度配上才发，配不上的位姿不送飞控（限频报错）。本地回显 /fastlio/vision_odom。
            要求 MAVROS 用 MAVLink2（ODOMETRY 是 v2 消息），飞控 EKF2_EV_CTRL 带速度位（bit2，11 -> 15）
            才会真的融合速度，不带时飞控只记录。PX4 把 ODOMETRY 当 EV 自有坐标系（FRD）、
            VISION_POSITION_ESTIMATE 当 NED，两种方式中途切换会让 EKF 重新对准航向。
    odom_velocity_std：报给飞控的速度标准差，PX4 取 max(EKF2_EVV_NOISE², 它的平方)，0 = 由 EVV_NOISE 决定。
  -->

  <arg name="send_to_mavros"     default="false" />
  <arg name="ev_mode"            default="pose" />
  <arg name="velocity_in"        default="/fastlio/velocity" />
  <arg name="vision_odom_out"    default="/fastlio/vision_odom" />
  <arg name="mavros_odom_topic"  default="/mavros/odometry/out" />
  <arg name="mavros_odom_frame"  default="px4_odom" />
  <arg name="odom_velocity_std"  default="0.0" />
  <arg name="odom_in"            default="/Odometry" />
  <arg name="gravity_in"         default="/fastlio/gravity_init" />
  <arg name="odom_out"           default="/fastlio/odom_world" />
  <arg name="pose_cov_out"       default="/fastlio/vision_pose_cov" />
  <arg name="world_frame"        default="drone_odom" />
  <arg name="input_frame"        default="camera_init" />
  <arg name="input_child_frame"  default="body" />
  <arg name="output_child_frame" default="drone_base" />
  <arg name="mounting_source"    default="fixed" />
  <arg name="mounting_roll_deg"  default="0.5" />
  <arg name="mounting_pitch_deg" default="18.8" />
  <arg name="mounting_yaw_deg"   default="1.6" />
  <arg name="publish_static_tf"  default="true" />
  <arg name="mavros_pose_cov_topic" default="/mavros/vision_pose/pose_cov" />

  <node pkg="fastlio_gravity_bridge" type="gravity_bridge_node" name="gravity_bridge"
        output="screen" required="false">
    <param name="odom_in"            type="string" value="$(arg odom_in)" />
    <param name="gravity_in"         type="string" value="$(arg gravity_in)" />
    <param name="odom_out"           type="string" value="$(arg odom_out)" />
    <param name="pose_cov_out"       type="string" value="$(arg pose_cov_out)" />
    <param name="world_frame"        type="string" value="$(arg world_frame)" />
    <param name="input_frame"        type="string" value="$(arg input_frame)" />
    <param name="input_child_frame"  type="string" value="$(arg input_child_frame)" />
    <param name="output_child_frame" type="string" value="$(arg output_child_frame)" />
    <param name="mounting_source"    type="string" value="$(arg mounting_source)" />
    <param name="mounting_roll_deg"  type="double" value="$(arg mounting_roll_deg)" />
    <param name="mounting_pitch_deg" type="double" value="$(arg mounting_pitch_deg)" />
    <param name="mounting_yaw_deg"   type="double" value="$(arg mounting_yaw_deg)" />
    <param name="mavros_pose_cov_topic" type="string" value="$(arg mavros_pose_cov_topic)" />
    <param name="publish_static_tf"  type="bool"   value="$(arg publish_static_tf)" />
    <param name="send_to_mavros"     type="bool"   value="$(arg send_to_mavros)" />
    <param name="ev_mode"            type="string" value="$(arg ev_mode)" />
    <param name="velocity_in"        type="string" value="$(arg velocity_in)" />
    <param name="vision_odom_out"    type="string" value="$(arg vision_odom_out)" />
    <param name="mavros_odom_topic"  type="string" value="$(arg mavros_odom_topic)" />
    <param name="mavros_odom_frame"  type="string" value="$(arg mavros_odom_frame)" />
    <param name="odom_velocity_std"  type="double" value="$(arg odom_velocity_std)" />
  </node>
</launch>
