Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 0; 0; 0
    Fixed Frame: drone_map_view
    Frame Rate: 20
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
    - Class: rviz/PointCloud2
      Name: Prior map
      Enabled: true
      Topic: /drone_reloc/view/map
      Style: Points
      Size (Pixels): 2
      Color Transformer: AxisColor
      Axis: Z
      Use rainbow: true
    - Class: rviz/PointCloud2
      Name: Live scan
      Enabled: true
      Topic: /cloud_registered
      Style: Points
      Size (Pixels): 3
      Decay Time: 1
      Color Transformer: FlatColor
      Color: 255; 255; 255
    - Class: rviz/Axes
      Name: Drone
      Enabled: true
      Reference Frame: base_link
      Length: 0.3
      Radius: 0.03
    - Class: rviz/Axes
      Name: Map frame
      Enabled: true
      Reference Frame: drone_map_view
      Length: 0.3
      Radius: 0.03
    - Class: rviz/Marker
      Name: Map label
      Enabled: true
      Marker Topic: /drone_reloc/view/map_label
    - Class: rviz/Marker
      Name: Reloc status
      Enabled: true
      Marker Topic: /drone_reloc/view/status_text
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 9
      Focal Point: {X: -0.9, Y: -0.1, Z: 0.5}
      Pitch: 1.1
      Yaw: 3.1416
