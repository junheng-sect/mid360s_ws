[Unit]
Description=Export completed PX4 ULogs for Orange Pi recordings
After=mid360s-roscore.service mid360s-mavros.service
PartOf=mid360s-roscore.service mid360s-mavros.service

[Service]
Type=simple
User=orangepi
Group=orangepi
Environment=HOME=/home/orangepi
ExecStart=/bin/bash /home/orangepi/mid360s_ws/scripts/resident/run_ulog_export.sh
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
Nice=10

[Install]
WantedBy=multi-user.target
