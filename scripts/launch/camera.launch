<launch>
  <!-- 独立的双路采集和任务视觉。控制台通过 H.264 观看，普通 fusion 默认不加载相机。 -->
  <arg name="camera_config" default="$(find ov13855_cam)/config/ov13855.yaml"/>
  <arg name="full_camera_config" default="$(find ov13855_cam)/config/ov13855_full.yaml"/>
  <arg name="vision_config" default="$(find ov13855_apriltag_vision)/config/ov13855_apriltag_vision.yaml"/>

  <node pkg="ov13855_cam" type="ov13855_cam_node" name="ov13855_cam" output="screen"
        respawn="true" respawn_delay="5">
    <rosparam command="load" file="$(arg camera_config)"/>
  </node>

  <node pkg="ov13855_cam" type="ov13855_cam_node" name="ov13855_full_cam" output="screen"
        respawn="true" respawn_delay="5">
    <rosparam command="load" file="$(arg full_camera_config)"/>
  </node>

  <node pkg="ov13855_apriltag_vision" type="ov13855_apriltag_vision_node"
        name="ov13855_apriltag_vision_node" output="screen"
        respawn="true" respawn_delay="5">
    <rosparam command="load" file="$(arg vision_config)"/>
  </node>
</launch>
