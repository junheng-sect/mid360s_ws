# 复制为同目录 local.env 后按本机修改。local.env 不进 Git。
# Bash 赋值语法；含空格的值请加引号。无需填写用户名或仓库绝对路径。
# 命令行参数优先于这里的设置；留空使用默认值/自动识别。

# 板端 ROS Master（默认 http://192.168.31.32:11311）
RVIZ_ROS_MASTER=""
# 默认根据到板端的路由自动识别；多网卡选错时才填写本机地址。
RVIZ_ROS_IP=""
# 默认 rviz_mid360s
RVIZ_CONTAINER_NAME=""
# 默认 ros-noetic-rviz:noetic
RVIZ_IMAGE_TAG=""
# 自定义配置的容器内路径；通常留空，自动使用本机个人布局。
# 例如在 home/ros/.rviz/ 中另存 laptop.rviz 后，填写 /home/ros/.rviz/laptop.rviz。
RVIZ_CONFIG=""
# 超预算时的左栏目标宽度和保守预算，可按屏幕调整。
RV_PANEL_TARGET_W=700
RV_PANEL_BUDGET_MB=12
